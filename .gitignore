# Ключи к API. В репозиторий не едут никогда.
.env

.venv/
__pycache__/
*.pyc

# Из папки data в репозиторий едет только snapshot — это и есть все
# данные приложения, 1.4 МБ. Остальное программа либо сделала сама,
# либо скачала: база матчей (почти 2 ГБ), иконки с CDN Valve, настройки
# окна и снимки пакетов от игры. Последние вдобавок личные — в них
# номера аккаунтов и ники из настоящих матчей.
backend/data/*
!backend/data/snapshot.json.gz

# Сборка
build/
dist/
installer/Output/

# Настройки редактора
.kilo/
